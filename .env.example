# Copy to .env and fill in. Never commit .env or .env.local.
# Next.js reads this file; docker compose reads it for the n8n service.
# `npx convex dev` writes CONVEX_DEPLOYMENT and NEXT_PUBLIC_CONVEX_URL into .env.local.

# ---------------------------------------------------------------- Next.js
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# ---------------------------------------------------------------- n8n (docker compose)
# Shared HMAC secret. Generate with: openssl rand -hex 32
# The SAME value must be set on Convex: npx convex env set N8N_WEBHOOK_SECRET <value>
N8N_WEBHOOK_SECRET=replace_with_openssl_rand_hex_32
# Convex HTTP actions host (.convex.site, NOT .convex.cloud).
# Local Convex backend: http://host.docker.internal:3211
CONVEX_HTTP_BASE_URL=https://your-deployment.convex.site
# Optional: POST target for notifications. Empty = log to `docker compose logs n8n`.
MOCK_NOTIFY_URL=
# Optional: POST target for failure alerts (Slack/Teams webhook, etc.). Empty = log only.
ALERT_WEBHOOK_URL=
# Public base URL of n8n (set to your tunnel URL if Convex cloud must reach it).
N8N_PUBLIC_URL=http://localhost:5678/

# ---------------------------------------------------------------- Convex deployment env
# Do NOT put these in a file. Set them on the deployment with `npx convex env set`:
#   CLERK_JWT_ISSUER_DOMAIN   https://your-app.clerk.accounts.dev
#   ADMIN_CLERK_IDS           user_abc123,user_def456
#   N8N_WEBHOOK_SECRET        same value as above
#   N8N_REQUEST_WEBHOOK_URL   http://localhost:5678/webhook/lendloop-request
