{
  "id": "lendloopErrorWf1",
  "name": "LendLoop 03 - Error Handler",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "pinData": {},
  "tags": [],
  "nodes": [
    {
      "parameters": {},
      "id": "634b693c-ae78-4636-8d34-a40513ea2579",
      "name": "On Workflow Error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const { execution = {}, workflow = {} } = $input.first().json;\nconst err = execution.error || {};\n// Structured alert. Never include headers, bodies, env values or signatures.\nconst scrub = (s) => String(s || '').replace(/[a-f0-9]{64}/gi, '[redacted]').slice(0, 500);\nreturn [{\n  json: {\n    severity: 'error',\n    source: 'lendloop-n8n',\n    workflowName: workflow.name || 'unknown',\n    workflowId: workflow.id || null,\n    executionId: execution.id || null,\n    executionUrl: execution.url || null,\n    failingNode: execution.lastNodeExecuted || (err.node && err.node.name) || 'unknown',\n    errorMessage: scrub(err.message || err.description || 'Unknown error'),\n    occurredAt: new Date().toISOString(),\n  },\n}];\n"
      },
      "id": "9da2964c-5079-4dd7-9ab2-fa8092d2b50b",
      "name": "Format Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "aa2b33de-a228-44b6-acd6-1ad409a426e8",
              "leftValue": "={{ $env.ALERT_WEBHOOK_URL || '' }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "093b845f-f8dc-4ab7-bac5-c00d34467258",
      "name": "Alert URL Set?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ALERT_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "32591df7-f065-4295-9ab8-501be169c6f6",
      "name": "Send Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        200
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// Fallback alert channel: n8n stdout (docker compose logs n8n), plus this execution's saved data.\nfor (const item of $input.all()) console.log('[lendloop ALERT]', JSON.stringify(item.json));\nreturn $input.all();\n"
      },
      "id": "219514ae-6e28-4252-bdab-9b4196ef6f47",
      "name": "Log Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        400
      ]
    }
  ],
  "connections": {
    "On Workflow Error": {
      "main": [
        [
          {
            "node": "Format Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Alert": {
      "main": [
        [
          {
            "node": "Alert URL Set?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Alert URL Set?": {
      "main": [
        [
          {
            "node": "Send Alert",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
