      "id": "fb01aad7-2630-48a0-a789-ca684d84bbe3",
      "name": "Reject (alert)",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        880,
        420
      ]
    },
    {
      "parameters": {
        "jsCode": "const p = $('Verify Signature').first().json.payload;\nconst range = `${p.startDate} to ${p.endDate}`;\nconst messages = {\n  loan_requested: `Hi ${p.recipientDisplayName}, a neighbor asked to borrow your ${p.toolName} (${range}).`,\n  loan_approved: `Hi ${p.recipientDisplayName}, your request for ${p.toolName} (${range}) was approved.`,\n  loan_declined: `Hi ${p.recipientDisplayName}, your request for ${p.toolName} was declined.`,\n  loan_returned: `Hi ${p.recipientDisplayName}, thanks for returning the ${p.toolName}.`,\n};\nreturn [{\n  json: {\n    recipient: p.recipientDisplayName,\n    message: messages[p.eventType] || `Update on ${p.toolName}: ${p.status}.`,\n    ref: p.eventId,\n  },\n}];\n"
      },
      "id": "6119b761-b0ee-4b84-bfe0-aab562a6dd99",
      "name": "Build Notification",
