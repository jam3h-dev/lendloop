    {
      "parameters": {
        "jsCode": "// No MOCK_NOTIFY_URL configured: \"deliver\" by logging (visible with CODE_ENABLE_STDOUT=true).\nfor (const item of $input.all()) console.log('[lendloop mock-notify]', JSON.stringify(item.json));\nreturn $input.all().map((item) => ({ json: { ...item.json, delivered: 'mock-log' } }));\n"
      },
      "id": "93cf1128-03d2-4d97-8357-2963526e0d6c",
      "name": "Log Mock Notification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $env.N8N_WEBHOOK_SECRET;\nif (!secret) throw new Error('N8N_WEBHOOK_SECRET is not set');\n// Contract: hex(HMAC_SHA256(secret, `${timestamp}.${rawBody}`)), timestamp = unix seconds.\nconst sign = (rawBody) => {\n  const timestamp = Math.floor(Date.now() / 1000).toString();\n  const signature = crypto.createHmac('sha256', secret).update(`${timestamp}.${rawBody}`).digest('hex');\n  return { timestamp, signature };\n};\n\nconst p = $('Verify Signature').first().json.payload;\nconst failed = Boolean($input.first().json.error);\nconst body = JSON.stringify({\n  idempotencyKey: 'notif:' + p.eventId,\n  loanId: p.loanId,\n  eventType: 'request_notification',\n  status: failed ? 'failed' : 'sent',\n  summary: (failed ? 'Notification failed' : 'Notification sent') + ' (' + p.eventType.replace('loan_', '') + ')',\n});\nreturn [{ json: { body, ...sign(body) } }];\n"
      },
      "id": "aa8b18a7-ff97-42ce-8ff7-ce70f0a75df9",
      "name": "Sign Write-back",
      "type": "n8n-nodes-base.code",
