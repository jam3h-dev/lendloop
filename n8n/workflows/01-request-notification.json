      "id": "396fee15-b23f-4beb-b4de-f5485feb98d4",
      "name": "Convex Loan Event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "6f1c2a4e-9b7d-4c1e-8a35-2f6d8b1c0e41"
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $env.N8N_WEBHOOK_SECRET;\nconst item = $input.first();\nconst headers = item.json.headers || {};\nconst signature = String(headers['x-lendloop-signature'] || '').trim().toLowerCase();\nconst timestamp = String(headers['x-lendloop-timestamp'] || '').trim();\nconst fail = (reason) => [{ json: { valid: false, reason } }];\n\nif (!secret) return fail('server_misconfigured');\nif (!signature || !timestamp) return fail('missing_signature_headers');\nif (!/^\\d{1,12}$/.test(timestamp)) return fail('invalid_timestamp');\n// Replay protection: reject timestamps more than 5 minutes away from now.\nif (Math.abs(Math.floor(Date.now() / 1000) - Number(timestamp)) > 300) return fail('stale_timestamp');\n\n// Verify the exact bytes Convex signed (Webhook node \"Raw Body\" option).\nif (!item.binary || !item.binary.data) return fail('raw_body_missing');\nconst rawBody = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\n\nconst expected = Buffer.from(crypto.createHmac('sha256', secret).update(`${timestamp}.${rawBody}`).digest('hex'));\nconst given = Buffer.from(signature);\nif (expected.length !== given.length || !crypto.timingSafeEqual(expected, given)) return fail('bad_signature');\n\nlet payload;\ntry { payload = JSON.parse(rawBody); } catch { return fail('invalid_json'); }\nconst fields = ['eventId', 'eventType', 'loanId', 'toolName', 'status', 'startDate', 'endDate', 'recipientDisplayName'];\nfor (const f of fields) if (typeof payload[f] !== 'string') return fail('missing_' + f);\n// Data minimization: keep only allow-listed fields, drop anything else.\nreturn [{ json: { valid: true, payload: Object.fromEntries(fields.map((f) => [f, payload[f]])) } }];\n"
      },
      "id": "b7bd730e-7d48-4e3a-99a6-281d4e4ffad2",
      "name": "Verify Signature",
      "type": "n8n-nodes-base.code",
